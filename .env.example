# Every environment variable LeeTKOB reads. Copy to .env and fill in locally.
# Never commit .env, and never put a real value in this file.

# --- App ---
NODE_ENV=
PORT=
LOG_LEVEL=

# --- Database (PostgreSQL 16) ---
DATABASE_URL=

# --- Auth ---
JWT_SECRET=

# --- LLM constraint checker ---
# Read by the app process only. None of these are ever passed to the sandbox.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=
LLM_COST_CAP_PER_LAB_USD=
GEMINI_API_KEY=
# --- Sandbox limits ---
# The sandbox container receives only the limits below: no secrets, no network.
SANDBOX_CPU_TIME_MS=
SANDBOX_WALL_TIME_MS=
SANDBOX_MEMORY_MB=
SANDBOX_MAX_PROCESSES=
SANDBOX_MAX_OUTPUT_KB=
