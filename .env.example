# Every environment variable LeeTKOB reads. Copy to .env and fill in locally.
# Never commit .env, and never put a real value in this file.

# --- App ---
NODE_ENV=
PORT=
LOG_LEVEL=
PUBLIC_DOMAIN=

# --- Database (PostgreSQL 16) ---
DATABASE_URL=

# --- Auth ---
JWT_SECRET=

# --- LLM constraint checker ---
# Read by the app process only. None of these are ever passed to the sandbox.
# LLM_PROVIDER: 9router. LLM_MODEL: ag/gemini-3.8-flash (Gemini 3.8 Flash through 9router).
# LLM_BASE_URL: the 9router OpenAI-compatible endpoint, e.g. http://127.0.0.1:20128/v1.
# LLM_API_KEY: a key created in the 9router dashboard (Endpoint & Key), never committed.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=
# Optional, for the cost per call in the call log: USD per million input/output tokens.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
LLM_COST_CAP_PER_LAB_USD=
MODEL_OFF=

# --- Sandbox limits ---
# The sandbox container receives only the limits below: no secrets, no network.
SANDBOX_CPU_TIME_MS=
SANDBOX_WALL_TIME_MS=
SANDBOX_MEMORY_MB=
SANDBOX_MAX_PROCESSES=
SANDBOX_MAX_OUTPUT_KB=

# 9router dashboard (docker-compose 9router service): a strong password and a random JWT secret.
NINEROUTER_PASSWORD=
NINEROUTER_JWT_SECRET=
