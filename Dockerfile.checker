# Checker image: MODEL_OFF=1 docker run --network none -v <dataset>:/data:ro leetkob-checker --data /data
# Only src/ and the runtime dependencies go in; .dockerignore keeps .env, tests and eval data out.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY src ./src
USER node
ENV MODEL_OFF=1
ENTRYPOINT ["node", "src/checker.js"]
